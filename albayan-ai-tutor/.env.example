# قاعدة بيانات albayan المشتركة — قراءة فقط
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/albayan"

# قاعدة بيانات المتجهات (Neon — pgvector) — يملكها ai-tutor
VECTOR_DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# نموذج التضمين (Gemini Embedding) — 768 بُعداً عبر MRL
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768

# البحث الدلالي — عدد النتائج الأولية (يُدمج لاحقاً بـ RRF)
VECTOR_TOP_K=20

# سر مشترك بين Laravel و NestJS لتوقيع/فحص تذكرة AI session
AI_SERVICE_SECRET="change-me-ai-service-secret"

# عميل Anthropic Claude
CLAUDE_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-sonnet-4-5"
CLAUDE_MAX_TOKENS=1024

# سقف نافذة سياق الاسترجاع للحروف (افتراضي 120000 ≈ قسم 40 صفحة كامل)
AI_RAG_MAX_CHARS=120000

# أوريجن الواجهة المسموح (CORS)
FRONTEND_URL="http://localhost:3000"

# مستوى سجلات Winston (اختياري) — يلغي تلقائي NODE_ENV: debug | info | warn | error
# غياب LOG_LEVEL → debug في التطوير و info في الإنتاج
LOG_LEVEL=debug

# Laravel API (متاح لاحقًا لسجلات الدردشة)
LARAVEL_API_URL="http://localhost:8000"

PORT=3001